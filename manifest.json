{
  "name": "Müziklerim",
  "short_name": "Müziklerim",
  "description": "Reklamsız, internetsiz müzik çalar. Telefonundaki şarkıları kolayca ekle ve dinle.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0b0e",
  "theme_color": "#0b0b0e",
  "lang": "tr",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "id": "./",
  "share_target": {
    "action": "./paylas",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".mp3",
            ".m4a",
            ".aac",
            ".wav",
            ".ogg",
            ".opus",
            ".flac",
            ".wma",
            ".amr"
          ]
        }
      ]
    }
  }
}